/**
 * Definition for a binary tree node.
 * function TreeNode(val, left, right) {
 *     this.val = (val===undefined ? 0 : val)
 *     this.left = (left===undefined ? null : left)
 *     this.right = (right===undefined ? null : right)
 * }
 */
/**
Strategy : Traverse both the trees by creating hash maps
for main tree and sub tree and check if subtrees hashmap exists in main tree hashmap
*/
/**
 * @param {TreeNode} root
 * @param {TreeNode} subRoot
 * @return {boolean}
 */
var isSubtree = function (root, subRoot) {

    let hashRoot = serialise(root);
    let hashSubRoot = serialise(subRoot);

    return hashRoot.includes(hashSubRoot);

};

const serialise = (root) => {

    let hash = "";

    function traverse(curr) {

        if (!curr) {
            hash = hash + '-#';
            return;
        }

        hash = hash + '-' + curr.val;
        traverse(curr.left);
        traverse(curr.right);

    }

    traverse(root);

    return hash;

}
