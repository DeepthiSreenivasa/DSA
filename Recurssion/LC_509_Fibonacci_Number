/**
 * @param {number} n
 * @return {number}
 * Startegy : sum of previous and previous.prebious number (past 2 numbers. Therefore base case has to get defined well)
 */
var fib = function(n) {
    

    if(n == 0 || n == - 1) {
        return 0;
    }

    if(n == 1){
        return 1
    }

    return fib(n-1) + fib(n-2);


};
