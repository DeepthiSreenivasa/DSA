function linearSearch(arr, key) {

    arr = [...new Set(arr)]
    console.log("Arr::", arr);
    for (var i = 0; i < arr.length; i++){
        if (arr[i] == key) {
            return i+1;
        } 
    }
          
}

const result = linearSearch([4,5,2,3,3,5],3);

console.log("Result::", result);



