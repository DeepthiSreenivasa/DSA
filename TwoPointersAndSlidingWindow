/**
 * @param {number[]} nums
 * @param {number} target
 * @return {number[]}
 */
var twoSum = function (nums, target) {

    let n = nums.length;
     

    for (var i = 0; i < n; i++) {

       let j = i+1;

        while (j < n) {
            if (nums[i] + nums[j] == target) {
                return [i, j]
            }
            j++;
        }
    }

};
