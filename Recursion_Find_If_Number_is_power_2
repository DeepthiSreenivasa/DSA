 * Startegy : Divide a number by 2 and if it divides completly && if it is not an odd number then it is power of 2
 * 
 */


function isPowerOfTwo(n) {

    if (n <=0 || n%2!=0) return false;

    if (n == 1) return true 

    return isPowerOfTwo(n / 2);


}

const result = isPowerOfTwo(13);

console.log("Result::", result);



