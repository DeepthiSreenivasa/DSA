/**
 * @param {string[]} words
 * @param {character} x
 * @return {number[]}
 */

//Strategy : Jus loop over each word in the array and see if the asked letter exists in that array
//Re did on Aug 15th

var findWordsContaining = function(words, x) {

    let n = words.length;
    let arr=[];
    
    for(var i=0;i<n;i++){
        for(var j=0;j<words[i].length;j++){
            if(words[i][j]===x){
                arr.push(i);
                break
            }
        }
    }

    return arr;
};
