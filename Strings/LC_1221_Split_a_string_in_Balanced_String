/**
Strategy use a counter and do +1 and -1 and check if it is 0. Then you increment the substring count, in the end you return the substring count
or use two counters as counter1 and counter2 and check if they both are equal
Re did on 15th Aug
**/


/**
 * @param {string} s
 * @return {number}
 */
var balancedStringSplit = function(s) {


    let count = 0;
    let subStringCount = 0;

    for(var i=0;i<s.length;i++){
        if(s[i]==="R"){
            count++;
        }else{
            count--;
        }

        if(count==0){
            subStringCount++;
        }
    }

    return subStringCount;
}

    
