/**
 * @param {string} s
 * @param {string} t
 * @return {boolean}
 */
var isAnagram = function (s, t) {

    let n = s.length;

    if(t==s) return true;

    if (s.length !== t.length) return false
    

    for (var i = 0; i < n; i++) {
        if ( t.length > 0 && t.includes(s[i])) {
            t = t.replace(s[i], '')
        }
    }

    return t.length === 0;
};
