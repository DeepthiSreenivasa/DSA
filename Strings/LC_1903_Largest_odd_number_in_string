/**
 * @param {string} num
 * @return {string}
 */
var largestOddNumber = function(num) {

    let num1 = num.split("")

    while(num1.length>0){
        if(num1[num1.length-1]%2 == 0){
            num1.splice(num1.length-1,1);
        }else{
            return num1.join("");
        }
    }

    return "";


};
