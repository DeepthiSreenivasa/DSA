/**
 * Definition for singly-linked list.
 * function ListNode(val, next) {
 *     this.val = (val===undefined ? 0 : val)
 *     this.next = (next===undefined ? null : next)
 * }
 */
/**
 * @param {ListNode} head
 * @param {number} k
 * @return {ListNode}
 */
var rotateRight = function (head, k) {

    if(!head || !head.next || k==0) return head;

    let sp = head;
    let fp = head;
    let cur = head;
    let length = 0;

    while (cur) {
        cur = cur.next;
        length++;
    }

     k = k % length;

     if(k==0) return head

    for (var i = 0; i <k; i++) {
        fp = fp.next;
    }

    while (fp.next) {
        sp = sp.next;
        fp = fp.next;
    }

    
    let newHead = sp.next;
    sp.next = null;
    fp.next = head;
   

    return newHead;


};
