//Strategy : build Dashes first then build the stars

function starPattern() {
    let n = 5;
    for (var i = 0; i < n; i++){
        let row = "";
        for (var j = 0; j < (n - 1) - i  ; j++){
            row = row + ' ';
        }
        for (var j = 0; j < i + 1; j++) {
            row = row + '*';
        }
        console.log(row)
    }

}

starPattern();
