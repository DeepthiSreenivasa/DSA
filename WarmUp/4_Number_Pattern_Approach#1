function starPattern() {
    for (var i = 0; i < 6; i++){
        let row = "";
        for (var j = 0; j < i + 1; j++){
            if (j % 2 == 0) {
                row = row + 1 + " "
            } else {
                row = row + 0 + " "
            }
        }
        console.log(row)
    }
}

starPattern()
