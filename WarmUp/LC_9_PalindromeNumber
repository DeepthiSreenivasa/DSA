/**
 * @param {number} x
 * @return {boolean}
 * Strategy : Conevrt number to string and use two pointers
 */
var isPalindrome = function (x) {

    x = x.toString()
    let n = x.length;
    let i = 0;
    let j = x.length - 1;


    while (i < j) {
        if (x[i] != x[j]){
            return false
        }
        i++;
        j--;
    }
    return true;

};
