let stack = [1,2,3,4,5,6];

function removeElement() {
    stack.pop();
    console.log(stack);
}

function addElement(item) {
    stack.push(item)
    console.log(stack);
}

function peekElement() {
    let topElement = stack[stack.length - 1];
    console.log(topElement)
    return topElement;
}

removeElement()
addElement("item")
peekElement()
