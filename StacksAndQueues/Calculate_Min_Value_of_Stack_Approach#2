/**Strategy : push the value as well as min value, while you push inside the satck itslef by comparing it with top most item in the stack**/
var MinStack = function () {
    this.s1 = [];
};

/** 
 * @param {number} val
 * @return {void}
 */
MinStack.prototype.push = function (val) {

    let small;

    if (this.s1.length == 0) {
        small = val;
    }
    else {
        let top = this.s1[this.s1.length - 1];

        if (val < top.small) {
            small = val;
        }else{
            small = top.small;
        }
    }

   
    this.s1.push({ item: val, small: small })
};

/**
 * @return {void}
 */
MinStack.prototype.pop = function () {
    this.s1.pop();
};

/**
 * @return {number}
 */
MinStack.prototype.top = function () {

    let n = this.s1.length ;

    return this.s1[n-1].item;

};

/**
 * @return {number}
 */
MinStack.prototype.getMin = function () {

    let n = this.s1.length ;

    if(n==0) return null

    let top; 

    top = this.s1[n-1];

    return top.small;


};

