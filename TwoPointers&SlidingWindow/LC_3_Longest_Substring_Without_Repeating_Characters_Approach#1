/**
 * @param {string} s
 * @return {number}
 */
var lengthOfLongestSubstring = function (s) {

    let n = s.length;
    let subStr = '';
    let finalSubStr = '';
    let i = 0;

    if (s.length == 1) return s.length;


    while (i < n) {

        if (!subStr.includes(s[i])) {
            subStr = subStr + s[i]
        } else {
            i = i - subStr.length;
            if (subStr.length >= finalSubStr.length) {
                finalSubStr = subStr;

            }
            subStr = ''
        }
        i++;
    }

    return   subStr.length > finalSubStr.length  ? subStr.length : finalSubStr.length;

};
