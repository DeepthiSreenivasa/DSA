/**
*
* Move the pointer from start when the pointer reached null 
 * Definition for singly-linked list.
 * function ListNode(val) {
 *     this.val = val;
 *     this.next = null;
 * }
 */

/**
 * @param {ListNode} headA
 * @param {ListNode} headB
 * @return {ListNode}
 */
var getIntersectionNode = function (headA, headB) {

    let cur1 = headA;
    let cur2 = headB;

    while (cur1 != cur2) {

        if (!cur1) {
            cur1 = headB;
        } else {
            cur1 = cur1.next;
        }

        if (!cur2) {
            cur2 = headA;
        } else {
            cur2 = cur2.next;
        }

        if(cur1 == cur2){
            console.log("into checker condition")
             return cur1;
        }
       

    }

     return cur1;


};
