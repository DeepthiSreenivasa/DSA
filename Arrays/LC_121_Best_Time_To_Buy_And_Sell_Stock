/**
 * @param {number[]} prices
 * @return {number}
 * Strategy : find the min price so far in the iteration, find the max profit you will obtain by traversing. "Logic is 
 * max Profit will be got only when u sell with min Price"
 */

Solved on 14th Aug 2026,15th Aug,19thAug

var maxProfit = function(prices) {

    let n = prices.length;
    let maxProfit = -Infinity;
    let minPrice = prices[0]

    for(var i=1;i<n;i++){
        minPrice = Math.min(minPrice,prices[i]);
        maxProfit = Math.max(maxProfit,prices[i]-minPrice) //Profit => SP-CP
    }

   
    return maxProfit <= 0 ? 0 : maxProfit;
};
