 * Startegy : Calulate the sum of the whole array and subtract it with the sum of the array with missing number
 * 
 */

var missingNumber = function(nums) {
    
    let n = nums.length;

    let totalSum = (n * (n+1)) / 2;

    let partialSum = 0;

    for(var i=0;i<n;i++){

        partialSum = partialSum + nums[i];

    }

     return totalSum - partialSum;

};
