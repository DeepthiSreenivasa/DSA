var removeDuplicates = function (arr) {
   
    const n = arr.length;
    let j = 1;
    let i = 0;

    while (j <= n) {
        if (arr[i] == arr[j]) {
            j++;
        } else {
            arr[i + 1] = arr[j];
            i++;
        }
    }
    return i;
};
