var moveZeroes = function (nums) {


    let i = 0;
    let j = 0;
    let n = nums.length;


    while(j<n){
        if(nums[j]==0){
           
        }else{
            nums[i]=nums[j];
            i++;
        }
        j++;
    }

    for(var k=i;k<n;k++){
        nums[k]=0;
    }
   

};
