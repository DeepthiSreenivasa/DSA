/**
 * @param {number[]} prices
 * @return {number}
 */
var maxProfit = function(prices) {

    let n = prices.length;
    let maxProfit = -Infinity;

    for(let i=0;i<n;i++){
        for(let j=i+1;j<n;j++){
            profit = prices[j]-prices[i];
            maxProfit = Math.max(maxProfit,profit)
        }
        
       
    }
    return maxProfit <= 0 ? 0 : maxProfit;
};
