//Re- did on 15th Aug

var merge = function (nums1, m, nums2, n) {

    let p1 = m - 1;
    let p2 = n - 1;
    let i = m + n - 1;


    while (p2 >= 0) {

        if (nums1[p1] > nums2[p2]) {
            nums1[i] = nums1[p1];
            p1--;


        } else {
            nums1[i] = nums2[p2];
            p2--;

        }
        i--;

    }

}



merge();
