var removeElement = function (nums, val) {


    let i = 0;
    let j = 0;
    let n = nums.length;

    while(j<n){
        if(nums[j]!=val){
            nums[i]=nums[j]
            i++;
            j++;
        }else{
            j++;
        }

    }

    return i;





};
