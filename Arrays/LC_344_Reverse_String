//Re-done on 14th Aug 2026,15th Aug

var reverseString = function(s) {

    let n = s.length;
    let j = n-1;
    let temp;

    for(var i=0;i<Math.floor(n/2);i++){
      
        temp = s[i];
        s[i]=s[j];
        s[j]=temp;
       j--;
    }
    console.log("rev::",s)
    
};
