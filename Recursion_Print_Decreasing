 * Startegy : Base Case (print until the numbers are greater than zero) +
              Recursion Case ( decrease the number by 1 and call the function again)
 * 
 */

function printNumbersDecreasing(num) {

    if (num < 0) return;

    console.log(num);
    num = num - 1;
    printNumbersDecreasing(num)

   
}

printNumbersDecreasing(5)

