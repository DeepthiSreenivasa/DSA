/**
 * @param {number[]} nums
 * @param {number} target
 * @return {number}
 * Logic : Identify which side of the array is sorted , then apply binary search algo accordingly
 */
var search = function (nums, target) {

    let n = nums.length;
    let l = 0;
    let r = n - 1;
    let m;


    while (l <= r) {

        m = Math.floor((l + r) / 2);

        if (target === nums[m]) {
            return m
        }

        if (nums[m] >= nums[l]) { //left sorted

            if (target < nums[m] && target >= nums[l]) {
                r = m - 1
            } else {
                l = m + 1
            }
        } else {

            if (target > nums[m] && target <= nums[r]) {
                l = m + 1
            } else {
                r = m - 1
            }

        }

    }

    return -1;

};
