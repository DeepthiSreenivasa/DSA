 * 
 * Math.abs => convert every number to positive number
 * Math.floor=>Round the number to lowest
 * Math.ciel=> Round the number to highest
 * Math.round=>Round the number to lower(when <=0.4) or higher(when >=0.5)  
 * limit condition added to return zero when crosses the expected limit...Math.pow(2,31)
 */
var reverse = function(num) {
    
    let rev=0;
    let lastDigit;
    let neg = false;

    if (num < 0) {
        num = Math.abs(num)
        neg = true;
    }

    while (num > 0) {

        lastDigit = num % 10;
        rev = (10*rev) + lastDigit;
        num = Math.floor(num/10)
        
    }

    let limit = Math.pow(2,31);

    if(rev < -limit || rev > limit) return 0;
    
    return neg == true ? -rev :rev
};
